<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ のパッケージ可視性。Google レコーダーを起動できるよう明示する。 -->
    <queries>
        <package android:name="com.google.android.apps.recorder" />
    </queries>

    <application
        android:name=".SalesLogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalesLogDevice">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SalesLogDevice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pixel Recorder などからの共有テキスト受信 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- AppWidgetManager から呼ばれるため exported=true。
             ただし APPWIDGET_UPDATE 以外は受けない（独自actionは内部Receiverで処理）。 -->
        <receiver
            android:name=".widget.SalesLogWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sales_log_widget_info" />
        </receiver>

        <!-- 独自actionは内部Receiverで受ける。exported=false で他アプリからの呼び出しは届かない。 -->
        <receiver
            android:name=".widget.SalesLogWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.saleslogdevice.widget.ACTION_START" />
                <action android:name="com.example.saleslogdevice.widget.ACTION_CHECKOUT" />
                <action android:name="com.example.saleslogdevice.widget.ACTION_FINISH" />
                <action android:name="com.example.saleslogdevice.widget.ACTION_REFRESH" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
