<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="営業ログ端末" />

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:text="状態: 未開始" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/widget_btn_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="営業開始"
            android:textSize="12sp"
            android:textColor="@color/widget_background"
            android:background="@color/widget_primary" />

        <Space
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/widget_btn_checkin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="チェックイン"
            android:textSize="12sp"
            android:textColor="@color/widget_background"
            android:background="@color/widget_primary" />

        <Space
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/widget_btn_checkout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="チェックアウト"
            android:textSize="12sp"
            android:textColor="@color/widget_background"
            android:background="@color/widget_accent" />

        <Space
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/widget_btn_finish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="営業終了"
            android:textSize="12sp"
            android:textColor="@color/widget_background"
            android:background="@color/widget_primary" />
    </LinearLayout>

</LinearLayout>
